@echo off
setlocal EnableDelayedExpansion
title FFmpeg Full Build Auto-Installer ^& Environment PATH Configurator - by Biraj2004
cd /d "%~dp0"

:: =======================================================================================================
:: GitHub      : https://github.com/Biraj2004
:: Developer   : Biraj
:: Description : Checks if FFmpeg Full Build (ffmpeg, ffprobe, ffplay) is installed and in PATH.
::                - If ALREADY installed: Displays status, shows BOTH environment PATH status
::                  and full executable locations for ffmpeg, ffprobe, ffplay + version info.
::                - If NOT installed: Downloads latest official FFmpeg Full Build (GPL),
::                  extracts to %LOCALAPPDATA%\FFmpeg, sets User Environment PATH permanently,
::                  and displays both PATH status and installed executable locations.
:: =======================================================================================================

echo =======================================================================================================
echo                       FFMPEG FULL BUILD AUTOMATED INSTALLER ^& PATH CONFIGURATOR
echo                       Developed by : Biraj
echo                       GitHub       : https://github.com/Biraj2004
echo =======================================================================================================
echo.

where powershell >nul 2>&1
if errorlevel 1 (
    echo [ERROR] PowerShell was not found on this system. Cannot continue.
    echo.
    pause
    exit /b 1
)

powershell -NoProfile -NoLogo -ExecutionPolicy Bypass -EncodedCommand ""

if not errorlevel 10 (
    echo.
    pause
    endlocal
    exit /b 0
)

echo [INFO] Working Folder   : %CD%
echo [INFO] Status           : FFmpeg is currently NOT found in system PATH.
echo [INFO] Environment PATH : NOT CONFIGURED
echo [INFO] Action           : Download latest FFmpeg Full Build (ffmpeg, ffprobe, ffplay) ^& set User PATH.
echo [INFO] Target Directory : %LOCALAPPDATA%\FFmpeg
echo.
echo =======================================================================================================
echo  WARNING: This will download FFmpeg Full Build and modify your User Environment PATH variable.
echo =======================================================================================================
echo.
set "CONFIRM="
set /p CONFIRM=Type Y and press Enter to proceed with installation, or N to cancel : 

if /i "%CONFIRM%"=="Y" goto :PROCEED
if /i "%CONFIRM%"=="YES" goto :PROCEED

echo.
echo [CANCELLED] Installation cancelled. No files were downloaded or modified.
echo.
pause
endlocal
exit /b 0

:PROCEED
echo.
echo [PROCESSING] Launching PowerShell installer engine...
echo =======================================================================================================

powershell -NoProfile -NoLogo -ExecutionPolicy Bypass -EncodedCommand ""

echo -------------------------------------------------------------------------------------------------------
echo =======================================================================================================
echo [FINISHED] Script execution finished. GitHub: https://github.com/Biraj2004
echo =======================================================================================================
echo.
pause
endlocal
